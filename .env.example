# ==========================================
# VibeLock Environment Variables
# ==========================================

# ------------------------------------------
# Application
# ------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Local development: NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production deployment: NEXT_PUBLIC_APP_URL=https://vibelock.bd
# Vercel Preview deployments: NEXT_PUBLIC_APP_URL=https://vibelock-pre.vercel.app
# ------------------------------------------
# Database
# ------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# ------------------------------------------
# Authentication (Auth.js) - Placeholders
# ------------------------------------------
AUTH_SECRET="use-a-strong-secret-in-production-generated-via-openssl"
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Production Auth.js URL: set AUTH_URL=https://vibelock.bd.
# Keep AUTH_TRUST_HOST unset unless a verified reverse proxy normalizes the Host header.

# ------------------------------------------
# Cloudinary - Placeholders
# ------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------
# SSLCommerz Payment Gateway - Placeholders
# ------------------------------------------
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# ------------------------------------------
# bKash Payment Gateway - Placeholders
# ------------------------------------------
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=true

# ------------------------------------------
# Nagad Payment Gateway - Placeholders
# ------------------------------------------
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_PG_PUBLIC_KEY=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_SANDBOX=true

# Shipping Provider
SHIPPING_PROVIDER=mock
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_BASE_URL=https://portal.steadfast.com.bd/api/v1

# Email Configuration (Resend)
RESEND_API_KEY=
EMAIL_FROM=VibeLock <noreply@vibelock.bd>

# Rate Limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------
# Catalog Cache Invalidation Webhook
# Best-effort delivery from Core Backend
# ------------------------------------------
REVALIDATION_WEBHOOK_SECRET=
