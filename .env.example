# ==========================================
# VibeLock Environment Variables Example
# Copy to .env.local for local development
# ==========================================

# ------------------------------------------
# Application
# ------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Local development: NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production deployment: NEXT_PUBLIC_APP_URL=https://vibelock.bd
# Vercel Preview deployments: NEXT_PUBLIC_APP_URL=https://vibelock-pre.vercel.app

# ------------------------------------------
# Database
# ------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# ------------------------------------------
# Authentication (Auth.js) - Placeholders
# ------------------------------------------
AUTH_SECRET="use-a-strong-secret-in-production-generated-via-openssl"
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Production Auth.js URL: set AUTH_URL=https://vibelock.bd.
# Keep AUTH_TRUST_HOST unset unless a verified reverse proxy normalizes the Host header.

# ------------------------------------------
# Cloudinary - Placeholders
# ------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------
# PayStation Payment Gateway (Hosted Checkout)
# ------------------------------------------
PAYSTATION_MERCHANT_ID=
PAYSTATION_PASSWORD=
PAYSTATION_SANDBOX=true

# ------------------------------------------
# bKash Payment Gateway (Tokenized API)
# ------------------------------------------
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=true

# ------------------------------------------
# Shipping Provider (Steadfast Logistics)
# ------------------------------------------
SHIPPING_PROVIDER=mock
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_BASE_URL=https://portal.steadfast.com.bd/api/v1
COURIER_WEBHOOK_SECRET=

# ------------------------------------------
# SMS Gateway & Phone Verification
# ------------------------------------------
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=VibeLock

# ------------------------------------------
# Email Configuration (Resend)
# ------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=VibeLock <noreply@vibelock.bd>

# ------------------------------------------
# Cron & Scheduled Tasks (Abandoned Recovery & Cleanup)
# ------------------------------------------
CRON_SECRET=

# ------------------------------------------
# Rate Limiting & Distributed Cache (Upstash Redis)
# ------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------
# Catalog Cache Invalidation Webhook
# Best-effort delivery from Core Backend
# ------------------------------------------
REVALIDATION_WEBHOOK_SECRET=

# ------------------------------------------
# Meta Pixel & Conversions API (CAPI)
# ------------------------------------------
NEXT_PUBLIC_META_PIXEL_ID=
META_CONVERSIONS_API_ACCESS_TOKEN=
# Optional: Set this to verify events in Meta Events Manager > Test Events tab
META_TEST_EVENT_CODE=
